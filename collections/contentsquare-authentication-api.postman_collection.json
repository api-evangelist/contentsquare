      "item": [
        {
          "id": "10079c98-7594-4f45-b984-54ad5ae94428",
          "name": "Obtain an OAuth 2.0 access token",
          "request": {
            "name": "Obtain an OAuth 2.0 access token",
            "description": {
              "content": "Exchange client credentials for a short-lived (1 hour) bearer token used\non all subsequent API calls. The response also includes the regional\nbase URL to use for subsequent requests.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "oauth",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "client_id",
                  "value": "<string>",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "key": "client_secret",
                  "value": "<string>",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "key": "grant_type",
                  "value": "<string>",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "key": "scope",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "project_id",
                  "value": "<string>",
                  "description": "Required only for account-level credentials"
                }
              ]
            }
          },
          "response": [
            {
              "id": "20963536-db0d-46ff-822d-78ccd45ba223",
              "name": "Token issued",
              "originalRequest": {
                "url": {
                  "path": [
                    "v1",
                    "oauth",
                    "token"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: bearer",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Bearer <token>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "urlencoded",
                  "urlencoded": [
                    {
                      "disabled": false,
                      "description": {
                        "content": "(Required) ",
                        "type": "text/plain"
                      },
                      "key": "client_id",
                      "value": "<string>"
                    },
                    {
                      "disabled": false,
                      "description": {
                        "content": "(Required) ",
                        "type": "text/plain"
                      },
                      "key": "client_secret",
                      "value": "<string>"
                    },
                    {
                      "disabled": false,
                      "description": {
                        "content": "(Required) ",
                        "type": "text/plain"
                      },
                      "key": "grant_type",
                      "value": "<string>"
                    },
                    {
                      "disabled": false,
                      "key": "scope",
                      "value": "data-export"
                    },
                    {
                      "disabled": false,
                      "description": {
                        "content": "Required only for account-level credentials",
                        "type": "text/plain"
                      },
                      "key": "project_id",
                      "value": "<string>"
                    }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"access_token\": \"string\",\n  \"token_type\": \"Bearer\",\n  \"expires_in\": 3600,\n  \"scope\": \"string\",\n  \"project_id\": \"string\",\n  \"api_base_url\": \"http://NYsHuVdu.rkdiWCFLP4A1dHlF\"\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            }
          ],
          "event": [],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          }
        }
