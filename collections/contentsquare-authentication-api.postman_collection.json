      "event": []
    }
  ],
  "event": [],
  "variable": [
    {
      "type": "string",
      "value": "https://api.contentsquare.com",
      "key": "baseUrl"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{bearerToken}}"
      }
    ]
  },
  "info": {
    "_postman_id": "c8f28d64-9a65-4dc7-971e-fc92419ae306",
    "name": "Contentsquare Data Export Authentication API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Contentsquare Data Export API lets you programmatically create export\njobs and retrieve exported files for pageview-level or session-level raw\ndata. Authentication uses server-to-server OAuth 2.0 (client_credentials)\nand the access token (Bearer) returned at authentication time must be sent\non every subsequent request.\n\n\nContact Support:\n Name: Contentsquare Developer Documentation",
      "type": "text/plain"
    }
  }
